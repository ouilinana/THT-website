# Notion (create integration at https://www.notion.so/my-integrations, share DB with it)
NOTION_TOKEN=secret_xxxxxxxx
NOTION_DATABASE_ID=9e4d3dbc496e4074b8dc5975f1fc398d
# Optional: separate Notion database for contact form messages (defaults to NOTION_DATABASE_ID)
NOTION_CONTACT_DATABASE_ID=

# Notification email. Who receives contact and newsletter notifications (comma separated).
NOTIFY_TO=compagnie.tht@gmail.com

# Resend (preferred, HTTPS). Used whenever RESEND_API_KEY is set. Needed on Railway,
# which blocks outbound SMTP on non-Pro plans.
RESEND_API_KEY=
# Defaults to the Resend test sender, which only delivers to the Resend account owner's
# address. Use an address on a verified domain to send anywhere.
RESEND_FROM=THT site <onboarding@resend.dev>

# SMTP fallback (Infomaniak example), only used when RESEND_API_KEY is empty
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_USER=compagnie.tht@gmail.com
SMTP_PASS=
SMTP_FROM=compagnie.tht@gmail.com

# Local / CI test mode (skips Notion + email)
SUBSCRIBE_TEST_MODE=0

# Subscribe API bind (inside container)
SUBSCRIBE_BIND=127.0.0.1
SUBSCRIBE_PORT=8000
